{
  "name": "haramaya-findit",
  "private": true,
  "version": "1.0.0",
  "description": "AI-assisted lost-and-found platform for Haramaya University",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "lint": "npm run lint --workspace client",
    "test": "npm run test --workspace server -- --runInBand"
  },
  "keywords": [
    "haramaya",
    "lost-and-found",
    "react",
    "express",
    "security"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
